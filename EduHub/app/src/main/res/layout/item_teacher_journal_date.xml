<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_date_container"
    android:layout_width="44dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="4dp"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tv_day_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пн"
        android:textColor="@color/text_gray_secondary"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="12.05"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/v_today_dot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_marks_grade_cell_purple"
        android:backgroundTint="@color/today_dot"
        android:visibility="gone" />

</LinearLayout>
