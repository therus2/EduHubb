<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_rounded_white"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оценка:"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4">

            <TextView
                android:id="@+id/btn_grade_2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/marks_text_red"
                android:background="@drawable/bg_marks_grade_box_red"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_grade_3"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:gravity="center"
                android:text="3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/marks_purple_main"
                android:background="@drawable/bg_marks_grade_box_purple"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_grade_4"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:gravity="center"
                android:text="4"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/marks_purple_main"
                android:background="@drawable/bg_marks_grade_box_purple"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_grade_5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/marks_purple_main"
                android:background="@drawable/bg_marks_grade_box_purple"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_selected_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center"
            android:text="Оценка не выбрана"
            android:textColor="@color/text_gray_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
