<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:id="@+id/tv_picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Оценка"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/grade_type_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/btn_type_current"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="Текущая"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_rounded_white"
            android:backgroundTint="@color/marks_purple_main"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/btn_type_control"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:text="Контрольная"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_rounded_white"
            android:backgroundTint="@color/marks_toggle_bg"
            android:textColor="@color/marks_purple_main" />

        <TextView
            android:id="@+id/btn_type_homework"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Домашняя"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_rounded_white"
            android:backgroundTint="@color/marks_toggle_bg"
            android:textColor="@color/marks_purple_main" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grade_row_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="5">

        <TextView
            android:id="@+id/btn_grade_2"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="2"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/grade_text_2"
            android:background="@drawable/bg_marks_grade_box_red"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/grade_bg_2" />

        <TextView
            android:id="@+id/btn_grade_3"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:text="3"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/grade_text_3"
            android:background="@drawable/bg_marks_grade_box_purple"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/grade_bg_3" />

        <TextView
            android:id="@+id/btn_grade_4"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:text="4"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/grade_text_4"
            android:background="@drawable/bg_marks_grade_box_purple"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/grade_bg_4" />

        <TextView
            android:id="@+id/btn_grade_5"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:text="5"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/grade_text_5"
            android:background="@drawable/bg_marks_grade_box_purple"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/grade_bg_5" />

        <TextView
            android:id="@+id/btn_grade_n"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="Н"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/grade_text_n"
            android:background="@drawable/bg_marks_grade_box_purple"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/grade_bg_n" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grade_row_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <TextView
            android:id="@+id/btn_grade_b"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="Б"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/grade_text_b"
            android:background="@drawable/bg_marks_grade_box_purple"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/grade_bg_b" />

        <TextView
            android:id="@+id/btn_grade_delete"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/marks_text_red"
            android:background="@drawable/bg_marks_grade_box_purple"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/grade_bg_2" />

        <View
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
