<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="2dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        
        <View
            android:id="@+id/indicator_line"
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:background="#8B29EE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            
            <TextView
                android:id="@+id/text_notify_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_marks_toggle_container"
                android:gravity="center"
                android:text="★"
                android:textColor="#8B29EE"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_notify_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Новая оценка"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_notify_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Алгебра: Отлично (5)"
                    android:textColor="@color/marks_text_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icon_notify_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/appbar_arrowback"
                android:rotation="270"
                android:tint="#8B29EE" />

        </LinearLayout>
    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/expanded_notify_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/text_notify_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Подробности уведомления будут отображаться здесь. Например, кто выставил оценку или какие именно изменения произошли в расписании."
            android:textColor="@color/marks_text_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/text_notify_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="14:30"
            android:textColor="#BDBDBD"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_mark_read"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_marks_pill_dark_purple"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Прочитано"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
